# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/physiosense_notifications?schema=public
DB_SCHEMA=public
DB_SSL=false

# App
NODE_ENV=development
PORT=3002
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:8081

# JWT (shared with auth service)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Firebase (Push Notifications)
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json

# Notification Settings
MAX_NOTIFICATION_RETRIES=3
DEFAULT_RETRY_DELAY_MS=60000